BACKEND_ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_DATABASE_URL=sqlite+aiosqlite:///./backend-dev.db
BACKEND_DB_POOL_SIZE=10
BACKEND_DB_MAX_OVERFLOW=20
BACKEND_DB_POOL_TIMEOUT=30
BACKEND_DB_POOL_RECYCLE=1800
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_TRUSTED_HOSTS=localhost,127.0.0.1,test
BACKEND_AUTH_SECRET=development-only-change-this-secret
BACKEND_ADMIN_USERNAME=admin
# Development-only fallback. Production must use the bcrypt hash below.
BACKEND_ADMIN_PASSWORD=change-me-in-development
BACKEND_ADMIN_PASSWORD_HASH=
BACKEND_ALLOW_DEV_ADMIN=true
BACKEND_LOG_LEVEL=INFO
BACKEND_RUN_MIGRATIONS=false

# Production/staging example:
# BACKEND_DATABASE_URL=mssql+aioodbc://user:password@server:1433/database?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=no
