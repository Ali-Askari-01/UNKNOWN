# Copy to .env.local and fill in real values. Never commit real secrets.

# HMAC key for signing admin session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin login username
ADMIN_USERNAME=admin

# bcrypt hash of the admin password.
# IMPORTANT: bcrypt hashes contain "$" which Next.js env loading mangles.
# Always store the hash base64-encoded with the "base64:" prefix:
#   node -e "console.log('base64:' + Buffer.from(require('bcryptjs').hashSync('your-password', 10)).toString('base64'))"
ADMIN_PASSWORD_HASH=

# Server bind
PORT=3000
HOSTNAME=localhost

# Planned: exact origin allowed for credentialed Socket.IO handshakes
CORS_ORIGIN=http://localhost:3000
