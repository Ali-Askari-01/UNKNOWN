# Frontend runtime configuration. Backend secrets belong in backend/.env or the deployment
# secret manager and must never be copied into this file.

PORT=3000
HOSTNAME=localhost

# Internal URL used by the Next.js rewrite to reach FastAPI.
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000

# Browser WebSocket endpoint for the FastAPI realtime service.
# Local default: ws://127.0.0.1:8000
NEXT_PUBLIC_FASTAPI_WS_URL=ws://127.0.0.1:8000
